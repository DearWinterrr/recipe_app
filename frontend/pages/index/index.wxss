/**index.wxss**/
page {
  background-color: #f8f8f8;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
}

.container {
  width: 100%;
  display: flex;
  flex-direction: column;
  padding: 0;
  box-sizing: border-box;
}

/* 搜索栏样式 */
.search-bar {
  position: relative;
  width: 100%;
  padding: 20rpx;
  background-color: #fff;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  box-sizing: border-box;
  z-index: 10;
}

.search-input {
  width: 100%;
  height: 70rpx;
  padding: 0 70rpx 0 30rpx;
  border-radius: 35rpx;
  background-color: #f1f1f1;
  box-sizing: border-box;
  font-size: 28rpx;
}

.search-icon {
  position: absolute;
  right: 40rpx;
  top: 35rpx;
  font-size: 32rpx;
  color: #999;
}

/* 搜索结果样式 */
.search-results {
  width: 100%;
  max-height: calc(100vh - 110rpx);
  background-color: #fff;
  z-index: 9;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.1);
  overflow-y: auto;
}

.search-result-item {
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #eee;
}

.result-name {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 10rpx;
}

.result-description {
  font-size: 24rpx;
  color: #999;
}

/* 内容区域样式 */
.content-area {
  width: 100%;
  height: calc(100vh - 110rpx);
}

/* 轮播图样式 */
.banner {
  width: 100%;
  height: 350rpx;
}

.banner-image {
  width: 100%;
  height: 100%;
}

.banner-title {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  padding: 20rpx;
  font-size: 32rpx;
  color: #fff;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
  box-sizing: border-box;
}

/* 食材选择区样式 */
.ingredients-section, .recipes-section, .selected-ingredients {
  width: 100%;
  margin-top: 30rpx;
  padding: 20rpx;
  background-color: #fff;
  box-sizing: border-box;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #333;
  padding-left: 10rpx;
  border-left: 8rpx solid #ff6b6b;
}

.ingredients-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
}

.ingredient-item {
  width: 160rpx;
  height: 70rpx;
  margin: 10rpx;
  background-color: #f8f8f8;
  border-radius: 35rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 26rpx;
  color: #666;
  box-shadow: 0 2rpx 5rpx rgba(0, 0, 0, 0.05);
}

/* 已选食材样式 */
.ingredients-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
}

.selected-ingredient-item {
  padding: 10rpx 20rpx;
  margin: 10rpx;
  background-color: #ff6b6b;
  border-radius: 30rpx;
  color: #fff;
  font-size: 26rpx;
  display: flex;
  align-items: center;
}

.remove-btn {
  margin-left: 10rpx;
  font-size: 28rpx;
  font-weight: bold;
}

/* 推荐菜谱列表样式 */
.recipes-list {
  width: 100%;
}

.recipe-card {
  width: 100%;
  height: 200rpx;
  margin-bottom: 20rpx;
  border-radius: 10rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  display: flex;
  background-color: #fff;
}

.recipe-image {
  width: 200rpx;
  height: 100%;
  object-fit: cover;
}

.recipe-info {
  flex: 1;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.recipe-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.recipe-description {
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
