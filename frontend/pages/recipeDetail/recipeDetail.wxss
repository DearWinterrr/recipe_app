/* recipeDetail.wxss */
page {
  background-color: #f8f8f8;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
}

.container {
  width: 100%;
  display: flex;
  flex-direction: column;
  padding: 0;
  box-sizing: border-box;
}

.loading, .error {
  width: 100%;
  height: 300rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  color: #999;
  font-size: 30rpx;
}

.recipe-detail {
  width: 100%;
  padding-bottom: 50rpx;
}

/* 菜谱头部样式 */
.recipe-header {
  width: 100%;
  position: relative;
  margin-bottom: 30rpx;
}

.recipe-image {
  width: 100%;
  height: 400rpx;
  object-fit: cover;
}

.recipe-title {
  position: absolute;
  bottom: 80rpx;
  left: 0;
  width: 100%;
  padding: 20rpx;
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
  box-sizing: border-box;
}

.recipe-description {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  padding: 20rpx;
  font-size: 26rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.7);
  box-sizing: border-box;
}

/* 通用区块样式 */
.section {
  width: 100%;
  margin-bottom: 30rpx;
  padding: 20rpx;
  background-color: #fff;
  box-sizing: border-box;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #333;
  padding-left: 10rpx;
  border-left: 8rpx solid #ff6b6b;
}

/* 营养成分样式 */
.nutrition-info {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.nutrition-item {
  width: 48%;
  height: 100rpx;
  margin-bottom: 20rpx;
  padding: 15rpx;
  border-radius: 10rpx;
  background-color: #f8f8f8;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.nutrition-label {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.nutrition-value {
  font-size: 28rpx;
  font-weight: bold;
  color: #ff6b6b;
}

/* 食材列表样式 */
.ingredients-list {
  width: 100%;
}

.ingredient-item {
  width: 100%;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.ingredient-name {
  font-size: 28rpx;
  color: #333;
}

.ingredient-quantity {
  font-size: 26rpx;
  color: #ff6b6b;
}

/* 制作步骤样式 */
.steps-list {
  width: 100%;
}

.step-item {
  width: 100%;
  margin-bottom: 30rpx;
  display: flex;
}

.step-number {
  width: 60rpx;
  height: 60rpx;
  border-radius: 30rpx;
  background-color: #ff6b6b;
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-right: 20rpx;
}

.step-content {
  flex: 1;
}

.step-description {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.step-image {
  width: 100%;
  height: 250rpx;
  margin-top: 20rpx;
  border-radius: 10rpx;
  object-fit: cover;
}

/* 推荐链接样式 */
.links {
  width: 100%;
  display: flex;
  justify-content: space-around;
  flex-wrap: wrap;
}

.link-item {
  width: 48%;
  height: 80rpx;
  border-radius: 10rpx;
  background-color: #f8f8f8;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 20rpx;
}

.link-icon {
  font-size: 30rpx;
  margin-right: 10rpx;
}

.link-text {
  font-size: 26rpx;
  color: #333;
} 